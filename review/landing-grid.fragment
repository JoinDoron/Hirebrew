    <section class="lp-product-section" id="platform" aria-labelledby="platform-title">
      <div class="lp-product-heading">
        <h2 id="platform-title">Great teams.<br>One connected platform.</h2>
        <p>Bring hiring, people operations and growth together. Give every team the context to act, and every person a clearer next step.</p>
      </div>
      <div class="lp-product-grid">
        <a class="lp-product-card lp-product-hire" href="products/hire.html" aria-label="Explore Hirebrew Hire">
          <div class="lp-product-card-heading"><h3>Hire</h3><span class="lp-product-arrow" aria-hidden="true">↗</span></div>
          <p class="lp-product-description">Connect your candidates, hiring teams and interview decisions.<br class="lp-wide-break"> Make the next great hire a team effort.</p>
          <div class="lp-mini lp-hire-preview" aria-hidden="true">
            <div class="lp-mini-appbar"><span><img src="assets/brand/mark.svg" width="19" height="19" alt="">Hirebrew Hire</span><span class="lp-avatar lp-avatar-small">TA</span></div>
            <div class="lp-hire-layout">
              <div class="lp-mini-nav"><span>Overview</span><span class="lp-mini-nav-active">Candidates</span><span>Interviews</span><span>Messages</span></div>
              <div class="lp-hire-main">
                <div class="lp-mini-heading"><div><span class="lp-mini-muted">Operations manager</span><strong>Your next conversation</strong></div><span class="lp-tag">Interview</span></div>
                <div class="lp-candidate-row"><span class="lp-avatar">AO</span><div><strong>Amaka Okafor</strong><span>Candidate / Lagos</span></div><span class="lp-mini-note">Panel review</span></div>
                <div class="lp-scorecard-row"><div><span>People</span><strong>Feedback ready</strong><span class="lp-scorecard-line"></span></div><div><span>Technical</span><strong>Feedback ready</strong><span class="lp-scorecard-line"></span></div><div><span>Operations</span><strong>Awaiting Chidi</strong><span class="lp-scorecard-line lp-scorecard-pending"></span></div></div>
                <div class="lp-mini-message"><span class="lp-avatar lp-avatar-small">AO</span><p>Should I prepare a presentation for the interview?</p><span class="lp-message-status">Reply in context →</span></div>
              </div>
            </div>
          </div>
        </a>

        <a class="lp-product-card lp-product-onboard" href="products/onboard.html" aria-label="Explore Hirebrew Onboard">
